            "replies": {
                "id": 1,
                "title": "\u0627\u0644\u0631\u062d\u0644\u0629 \u063a\u064a\u0631 \u0645\u062a\u0648\u0641\u0631 \u0639\u0644\u064a\u0647\u0627 \u0645\u0642\u0627\u0639\u062f",
                "content": "> \u0646\u0639\u062a\u0630\u0631\u060c \u0644\u0627 \u062a\u062a\u0648\u0641\u0631 \u062d\u0627\u0644\u064a\u0627\u064b \u0623\u064a \u0645\u0642\u0627\u0639\u062f \u0639\u0644\u0649 \u0627\u0644\u0631\u062d\u0644\u0629 \u0627\u0644\u062a\u064a \u0627\u062e\u062a\u0631\u062a\u0647\u0627.\r\n> \u0625\u0630\u0627 \u0631\u063a\u0628\u062a \u0628\u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0631\u062d\u0644\u0627\u062a \u0623\u062e\u0631\u0649\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 \"\u0628\u062d\u062b \u0639\u0646 \u0631\u062d\u0644\u0627\u062a\".\r\n> \u0648\u0641\u064a \u062d\u0627\u0644 \u0631\u063a\u0628\u062a\u0643 \u0628\u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0628\u0627\u0634\u0631\u0629 \u0645\u0639 \u0642\u0633\u0645 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 \"\u0627\u0644\u062f\u0639\u0645 \u0627\u0644\u0641\u0646\u064a\".",
